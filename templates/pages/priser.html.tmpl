  --accent: #f59e0b;
  --accent-light: #fde68a;
  --max: 900px;
  --radius: 20px;
  --shadow: 0 18px 40px rgba(0,0,0,0.25);
}

* { box-sizing: border-box; }

body {
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top, rgba(245,158,11,0.12), transparent 35%),
    linear-gradient(180deg, #0b1120 0%, #111827 100%);
  color: var(--text);
  margin: 0;
  padding: 1rem;
  line-height: 1.6;
}

.container {
  width: min(100% - 1rem, var(--max));
  margin: auto;
}

h1, h2, h3 { line-height: 1.2; }

h1 {
  text-align: center;
  font-size: clamp(1.8rem, 5vw, 3rem);
  margin-bottom: 1rem;
}

.intro {
  text-align: center;
  color: var(--muted);
  max-width: 70ch;
  margin: 0 auto 1rem;
}

.notice {
  background: rgba(245,158,11,0.14);
  border: 2px solid rgba(245,158,11,0.65);
  color: var(--accent-light);
  padding: 1.25rem;
  border-radius: var(--radius);
  margin: 1.5rem 0;
  box-shadow: var(--shadow);
}

.notice strong { color: #fff; }
.notice p { margin: 0.5rem 0 0; }

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin: 1.5rem 0 2rem;
}

.step {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.1rem;
}

.step-number {
  display: inline-flex;
  width: 2rem;
  height: 2rem;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent);
  color: #111827;
  font-weight: 900;
  margin-bottom: 0.65rem;
}

.step p { color: var(--muted); margin-bottom: 0; }

.tabs {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
  margin: 2rem 0;
}

.tab {
  padding: 0.7rem 1rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  cursor: pointer;
  font-weight: 700;
  border: 1px solid transparent;
  user-select: none;
  font: inherit;
  color: var(--text);
  appearance: none;
}

.tab:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}

.tab:hover { border-color: var(--line); }
.tab.active { background: var(--accent); color: #111827; }

.section { display: none; }
.section.active { display: block; }

.card {
  background: var(--card);
  border: 1px solid var(--line);
  padding: 1.5rem;
  border-radius: var(--radius);
  margin-bottom: 1rem;
  box-shadow: var(--shadow);
}

.highlight { border: 2px solid var(--accent); }

.price-label {
  color: var(--accent-light);
  font-size: 0.9rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: -0.35rem;
}

.price {
  font-size: 1.8rem;
  color: var(--accent);
  font-weight: 900;
  margin: 0.5rem 0;
}

.included-badge,
.separate-badge {
  display: inline-block;
  padding: 0.45rem 0.7rem;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.9rem;
  margin: 0.2rem 0 0.7rem;
}

.included-badge {
  background: rgba(34,197,94,0.14);
  border: 1px solid rgba(34,197,94,0.35);
  color: #bbf7d0;
}

.separate-badge {
  background: rgba(245,158,11,0.12);
  border: 1px solid rgba(245,158,11,0.35);
  color: var(--accent-light);
}

.card p,
.card li { color: var(--muted); }
.card ul { padding-left: 1.2rem; margin-bottom: 0; }

.card-note {
  margin-top: 1rem;
  padding-top: 0.85rem;
  border-top: 1px solid var(--line);
  color: var(--accent-light) !important;
  font-weight: 700;
}

.info-grid {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
}

.info-box {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 1.25rem;
}

.info-box p,
.info-box li { color: var(--muted); }

.button {
  display: flex;
  width: 100%;
  justify-content: center;
  align-items: center;
  margin-top: 1rem;
  padding: 0.9rem 1rem;
  background: var(--accent);
  color: #111827;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 900;
}

.button.secondary {
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--line);
}

.button:hover { filter: brightness(1.08); }
.small { font-size: 0.95rem; color: var(--muted); }

@media (max-width: 700px) {
  .steps { grid-template-columns: 1fr; }
