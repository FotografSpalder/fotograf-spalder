---
---
<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, follow">
  <meta name="description" content="Åpne ditt private bildegalleri hos Fotograf Spalder med bildekoden du har fått.">
  <title>Mine bilder | Fotograf Spalder</title>
  <link rel="canonical" href="https://www.fotograf-spalder.com/mine-bilder.html">
  <link rel="icon" type="image/png" href="Untitled-1.png">

  <style is:inline>
    :root {
      --bg: #0f172a;
      --card: rgba(255,255,255,0.08);
      --text: #f8fafc;
      --muted: #cbd5e1;
      --line: rgba(255,255,255,0.12);
      --accent: #f59e0b;
      --accent-light: #fde68a;
      --shadow: 0 18px 40px rgba(0,0,0,0.25);
      --radius: 22px;
      --max: 980px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, rgba(245,158,11,0.14), transparent 35%),
        linear-gradient(180deg, #0b1120 0%, #111827 100%);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }

    .container {
      width: min(100% - 2rem, var(--max));
      margin: 0 auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(12px);
      background: rgba(11,17,32,0.82);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 76px;
      gap: 1rem;
    }

    .brand {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .brand strong {
      font-size: 1.1rem;
      letter-spacing: 0.04em;
    }

    .brand span {
      color: var(--muted);
      font-size: 0.92rem;
    }

    .nav-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nav-links a {
      color: var(--muted);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
      color: var(--text);
    }

    .mobile-toggle {
      display: none;
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text);
      padding: 0.65rem 0.9rem;
      border-radius: 12px;
      font-weight: 700;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0.8rem 1.15rem;
      border-radius: 999px;
      border: 0;
      font-weight: 800;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .button.primary {
      background: var(--accent);
      color: #111827;
      box-shadow: var(--shadow);
    }

    .button.primary:hover {
      background: #fbbf24;
      transform: translateY(-1px);
    }

    main {
      padding: 5rem 0;
    }

    .gallery-card {
      max-width: 720px;
      margin: 0 auto;
      padding: clamp(1.4rem, 4vw, 2.5rem);
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: var(--card);
      box-shadow: var(--shadow);
    }

    .eyebrow {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      border: 1px solid rgba(245,158,11,0.4);
      background: rgba(245,158,11,0.12);
      color: var(--accent-light);
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    h1 {
      margin: 0 0 1rem;
      font-size: clamp(2rem, 6vw, 3.4rem);
      line-height: 1.1;
    }

    .lead {
      margin: 0 0 2rem;
      color: var(--muted);
      font-size: 1.08rem;
    }

    form {
      display: grid;
      gap: 0.8rem;
    }

    label {
      font-weight: 800;
    }

    input[type="text"] {
      width: 100%;
      min-height: 54px;
      padding: 0.9rem 1rem;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: rgba(15,23,42,0.75);
      color: var(--text);
      font: inherit;
      font-size: 1.05rem;
      outline: none;
    }

    input[type="text"]:focus {
      border-color: rgba(245,158,11,0.75);
      box-shadow: 0 0 0 3px rgba(245,158,11,0.14);
    }

    input::placeholder {
      color: #94a3b8;
    }

    .help {
      margin: 0 0 0.5rem;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .note {
      margin-top: 1.5rem;
      padding: 1rem;
      border-radius: 14px;
      border: 1px solid rgba(245,158,11,0.28);
      background: rgba(245,158,11,0.08);
      color: var(--muted);
    }

    .note strong { color: var(--text); }

    .back-link {
      display: inline-block;
      margin-top: 1.5rem;
      color: var(--accent-light);
      font-weight: 700;
    }

    @media (max-width: 820px) {
      .site-header { position: static; }

      .nav {
        align-items: flex-start;
        padding: 1rem 0;
      }

      .nav-wrap {
        flex-direction: column;
        align-items: flex-end;
      }

      .mobile-toggle {
        display: inline-flex;
      }

      .nav-links {
        display: none;
        flex-direction: column;
        align-items: flex-start;
        width: min(85vw, 320px);
        padding: 1rem;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: #111827;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links .button {
        width: 100%;
      }

      main {
        padding: 3rem 0;
      }
    }
  </style>

  <link rel="stylesheet" href="assets/css/site.css">
  <script is:inline src="samtykke.js" defer></script>
  <script is:inline src="assets/js/site.js" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="index.html" aria-label="Fotograf Spalder hjem">
        <strong>Fotograf Spalder</strong>
        <span>Kjæledyr, familie og portrett</span>
      </a>

      <div class="nav-wrap">
        <button class="mobile-toggle" id="mobileToggle" aria-label="Åpne meny" type="button" aria-controls="navLinks" aria-expanded="false">Meny</button>
        <nav class="nav-links" id="navLinks" aria-label="Hovedmeny">
          <a href="index.html">Forside</a>
          <a href="portfolio.html">Portefølje</a>
          <a href="priser.html">Priser</a>
          <a href="mine-bilder.html" aria-current="page">Mine bilder</a>
          <a class="button primary" href="booking.html">Book fotografering</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <div class="container">
      <section class="gallery-card" aria-labelledby="mine-bilder-title">
        <div class="eyebrow">Privat kundegalleri</div>
        <h1 id="mine-bilder-title">Se bildene dine</h1>
        <p class="lead">Skriv inn bildekoden du har fått fra Fotograf Spalder. Du blir sendt videre til det private galleriet ditt i FotoSky.</p>

        <form action="https://kuvatilaus.fi/kuvaus" method="GET">
          <label for="gallery-code">Bildekode</label>
          <input
            id="gallery-code"
            type="text"
            name="code"
            placeholder="Skriv inn bildekoden"
            maxlength="10"
            autocomplete="off"
            spellcheck="false"
            required
          >
          <p class="help">Koden finner du i informasjonen du har fått fra Fotograf Spalder.</p>
          <button class="button primary" type="submit">Åpne bildegalleri</button>
        </form>

        <div class="note">
          <strong>Du sendes videre til FotoSky.</strong><br>
          Selve bildegalleriet og eventuell bildebestilling håndteres i FotoSky sin galleriløsning.
        </div>

        <a class="back-link" href="index.html">← Tilbake til forsiden</a>
      </section>
    </div>
  </main>
</body>
</html>
