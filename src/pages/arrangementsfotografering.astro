    className: 'portrait',
    alt: 'Besøkende i aktivitet ved en salgsbod på sommermarked',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-portrett-av-deltakere',
    width: 1800,
    height: 1200,
    className: 'half',
    alt: 'Fire deltakere samlet til et naturlig gruppeportrett under sommermarkedet',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-kunstnerhjem-og-boder',
    width: 2000,
    height: 1333,
    className: 'half',
    alt: 'Vesterlien Kunstnerhjem og markedsboder sett fra høyden i sommerlandskap',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'fn-dagen-vesterlien-taler',
    width: 1200,
    height: 1800,
    className: 'portrait',
    alt: 'Mann holder tale med notater under markeringen av FN-dagen ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – FN-dagen',
  },
  {
    file: 'fn-dagen-vesterlien-portrett-i-folkedrakt',
    width: 1200,
    height: 1800,
    className: 'portrait',
    alt: 'Kvinne i folkedrakt fotografert i det historiske interiøret under FN-dagen ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – FN-dagen',
  },
  {
    file: 'julemarked-vesterlien-lykter',
    width: 2000,
    height: 1333,
    className: 'wide',
    alt: 'Gamle lykter henger over en utstilling på julemarkedet ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – julemarked',
  },
  {
    file: 'julemarked-vesterlien-utstillere',
    width: 2000,
    height: 1333,
