---
import { data, formatPrice } from '../lib/services';

const canonical = 'https://www.fotograf-spalder.com/arrangementsfotografering.html';
const imageBase = 'images/arrangementsfotografering';
const eventHalf = data.services['event-half'];
const eventFull = data.services['event-full'];
const eventHalfPrice = formatPrice(eventHalf, { group: true }).replace(/^Fra /, '');
const eventFullPrice = formatPrice(eventFull, { group: true }).replace(/^Fra /, '');

const portfolioImages = [
  {
    file: 'julegrantenning-brumunddal-sceneopptreden',
    width: 1333,
    height: 2000,
    className: 'portrait',
    alt: 'Artist i rød dress under sceneopptreden på julegrantenningen i Brumunddal',
    caption: 'Julegrantenning i Brumunddal',
  },
  {
    file: 'julegrantenning-brumunddal-artister-pa-scenen',
    width: 2000,
    height: 1383,
    className: 'wide',
    alt: 'Artister, julenisse og publikum under sceneprogrammet på julegrantenningen i Brumunddal',
    caption: 'Julegrantenning i Brumunddal',
  },
  {
    file: 'julegrantenning-brumunddal-opplyst-juletre',
    width: 1200,
    height: 1800,
    className: 'portrait',
    alt: 'Opplyst juletre mot mørk kveldshimmel under julegrantenningen i Brumunddal',
    caption: 'Julegrantenning i Brumunddal',
  },
  {
    file: 'sommermarked-vesterlien-oversikt',
    width: 2000,
    height: 895,
    className: 'feature',
    alt: 'Oversikt over sommermarked med salgsboder og besøkende ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-utstillere',
    width: 1800,
    height: 1200,
    className: 'half',
    alt: 'Tre utstillere bak en salgsbod med håndlagde varer på sommermarkedet ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-handlagde-produkter',
    width: 1800,
    height: 1200,
    className: 'half',
    alt: 'Heklede figurer og håndlagde produkter utstilt i en koffert på sommermarked',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-salgsbod',
    width: 2000,
    height: 1333,
    className: 'wide',
    alt: 'Salgsbod med lokale matvarer og håndverksprodukter på sommermarkedet ved Vesterlien Kunstnerhjem',
    caption: 'Vesterlien Kunstnerhjem – sommermarked',
  },
  {
    file: 'sommermarked-vesterlien-publikum',
